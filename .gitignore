# deps
node_modules/
.pnpm-store/

# build
dist/
web/dist/
src-tauri/target/
src-tauri/gen/
# icons/ is NOT ignored: they are generated once by `pnpm tauri icon` and
# generate_context! requires them to exist at build time — CI included.

# local data — the app's database never goes into git
*.db
*.db-journal
*.db-wal
*.db-shm

# secrets: Google tokens live in appdata, but never take the risk
google.json
*.local
.env
.env.*

# os
.DS_Store
Thumbs.db
desktop.ini

# editor
.vscode/
!.vscode/extensions.json
.idea/

# local preview config
.claude/
